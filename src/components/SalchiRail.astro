---
/**
 * Salchi como barra de progreso: la cabeza se queda arriba y, con el scroll, el cuerpo crece
 * y las patas bajan hasta el final de la página. Es un solo perro que se estira
 * (ver SalchiLargo.astro), no una línea con dos chapas.
 *
 * Incluye <SalchiDibujo /> (el trazado oficial, una vez por página): lo usan esta barra y la portada.
 */
import SalchiDibujo from './SalchiDibujo.astro';
import SalchiLargo from './SalchiLargo.astro';
---

<SalchiDibujo />

<div class="salchi-rail" data-salchi aria-hidden="true">
  <SalchiLargo class="salchi-perro" data-salchi-perro="" />
  <span data-salchi-guau class="salchi-guau">¡Guau!</span>
</div>

<style>
  .salchi-rail {
    --ancho: 56px;
    position: fixed;
    z-index: 50;
    top: 4.25rem;
    bottom: 0.75rem;
    right: 2px;
    width: var(--ancho);
    pointer-events: none;
    opacity: var(--visible, 1);
    transition: opacity 0.4s ease;
    /* línea roja con interior y filo blancos: se lee igual sobre rojo que sobre blanco */
    --salchi-tinta: var(--color-rojo);
    --salchi-relleno: var(--color-blanco);
  }
  @media (min-width: 768px) {
    .salchi-rail {
      --ancho: 74px;
      right: 4px;
    }
  }

  .salchi-perro {
    width: 100%;
    will-change: transform;
  }

  /* bocadillo de la celebración final, junto a la cabeza */
  .salchi-guau {
    position: absolute;
    right: calc(100% - 4px);
    top: 0.35rem;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--color-blanco);
    color: var(--color-rojo);
    border: 2.5px solid var(--color-rojo);
    font-family: var(--font-titular);
    font-size: 0.8rem;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    scale: 0.4;
    transform-origin: right center;
  }
</style>
