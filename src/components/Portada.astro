---
import SalchiLargo from './SalchiLargo.astro';
import AbiertoAhora from './AbiertoAhora.astro';
import Icono from './Icono.astro';
import { NEGOCIO, FRASE_SALCHI } from '../data/negocio';
import { ruta } from '../lib/ruta';
---

<header id="portada" data-portada class="relative flex min-h-svh flex-col overflow-hidden bg-rojo text-blanco">
  <!-- Barra superior. El logotipo con texto llegará con los archivos de marca: aquí va texto plano, no una imitación -->
  <div class="con-rail flex items-center justify-between gap-4 px-4 pt-4 text-[11px] uppercase tracking-[0.18em] sm:px-8 sm:text-xs">
    <span class="font-bold">La Salchichería · Oeste 7</span>
    <a href={NEGOCIO.instagram} class="underline-offset-4 hover:underline" rel="noopener" target="_blank">
      {NEGOCIO.instagramUser}<span class="sr-only"> (Instagram, se abre en otra pestaña)</span>
    </a>
  </div>

  <div class="con-rail relative flex flex-1 flex-col items-center justify-center px-4 pt-6 pb-4 text-center sm:px-8">
    <!-- Salchi encogido (SVG oficial en blanco). Al hacer scroll se estira a la vista: la cabeza sube con la
         página y las patas se quedan atrás (el cuerpo crece hasta el 70 % del alto de pantalla).
         Relleno rojo: así el cuerpo tapa limpiamente el texto por el que pasa. Va por encima (z-10) y no
         intercepta toques. Usa el dibujo de <SalchiDibujo /> (dentro de SalchiRail, en la misma página). -->
    <div data-portada-salchi class="respira pointer-events-none relative z-10 mb-3 w-[37.5vw] max-w-[188px] min-w-[130px] sm:mb-4">
      <SalchiLargo
        titulo="Salchi, el perro salchicha con gafas de sol de La Salchichería"
        class="w-full text-blanco [--largo:70vh] [--salchi-relleno:var(--color-rojo)]"
      />
    </div>
    <!-- Salchi se presenta: es el anfitrión que acompaña toda la visita (la barra de la derecha es él) -->
    <p data-lema class="mb-5 font-mano text-lg -rotate-2 sm:mb-6 sm:text-2xl">{FRASE_SALCHI}</p>

    <h1 class="font-titular leading-[0.92] text-balance uppercase">
      <span class="sr-only">La Salchichería, bar en la Plaza del Oeste de Salamanca. </span>
      <span data-lema class="block text-[clamp(2.1rem,10.5vw,6.5rem)]">Hambre no vais a pasar</span>
      <span data-lema class="mt-2 block font-condensada text-[clamp(1.6rem,7vw,4rem)] font-normal tracking-wide text-blanco/90 italic">
        · Sed tampoco ·
      </span>
    </h1>

    <div data-portada-info class="mt-7 flex flex-col items-center gap-5">
      <AbiertoAhora />
      <div class="flex flex-wrap items-center justify-center gap-x-3 gap-y-4">
        <!-- Primario: la carta, a un toque -->
        <a href={ruta('carta/')} class="btn btn-primario bg-blanco px-8 text-base text-rojo sm:text-lg">
          Ver carta <Icono nombre="flecha" />
        </a>
        <!-- Secundario -->
        <a href={NEGOCIO.comoLlegar} class="btn border-2 border-blanco text-blanco" rel="noopener" target="_blank">
          Cómo llegar<span class="sr-only"> (Google Maps, se abre en otra pestaña)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Indicación de scroll: discreta y estática (solo la flecha baja un poco, despacio) -->
  <a href="#comer" class="mx-auto mb-5 inline-flex min-h-11 items-center gap-2 px-4 text-[11px] tracking-[0.18em] uppercase sm:text-xs">
    Desliza para entrar al bar
    <Icono nombre="abajo" class="baja-suave inline-block size-[1.15em]" />
  </a>
</header>

<style>
  /* Botón primario de la portada: más cuerpo y sombra dura para que mande sobre el secundario */
  .btn-primario {
    min-height: 56px;
    box-shadow: 5px 5px 0 var(--color-rojo-oscuro);
  }
  .btn-primario:hover {
    box-shadow: 7px 7px 0 var(--color-rojo-oscuro);
  }
</style>
