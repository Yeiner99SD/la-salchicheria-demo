---
interface Props {
  numero: number;
  titulo: [string, string];
  id: string;
  sub?: string;
}
const { numero, titulo, id, sub } = Astro.props;
---

<div class="con-rail mx-auto max-w-6xl px-4 pt-20 pb-12 sm:px-8 sm:pt-28">
  <p class="font-mano text-xl -rotate-2 sm:text-2xl">Capítulo {numero}</p>
  <h2 id={id} class="mt-2 font-condensada text-[clamp(4.5rem,24vw,14rem)] leading-[0.84] uppercase">
    <span class="block overflow-hidden"><span data-titular class="block">{titulo[0]}</span></span>
    <span class="block overflow-hidden"><span data-titular data-estira class="block origin-left">{titulo[1]}</span></span>
  </h2>
  {sub && <p class="mt-6 max-w-md text-sm leading-relaxed sm:text-base">{sub}</p>}
  <slot />
</div>
