---
/**
 * Tarjeta de un destacado de «Como Dios manda».
 * Se usa dos veces: para pintar los destacados en el servidor y, vacía, como <template> que el navegador
 * clona y rellena cuando hay una lista guardada desde /admin (ver src/scripts/destacados.ts).
 * Por eso cada dato va en un elemento con su atributo data-d-*.
 */
import type { Destacado } from '../data/destacados';
import type { FotoLista } from '../data/fotos-destacados';

interface Props {
  destacado?: Destacado;
  foto?: FotoLista;
}
const { destacado: d, foto } = Astro.props;
---

<li data-plato data-destacado class="w-[70vw] max-w-[300px] shrink-0">
  <div class="relative">
    <img
      data-d-foto
      hidden={!foto}
      src={foto?.src}
      srcset={foto?.srcset}
      sizes="(min-width: 640px) 300px, 70vw"
      alt={foto?.alt ?? ''}
      width="600"
      height="750"
      loading="lazy"
      decoding="async"
      class="aspect-[4/5] w-full rounded-[2rem] object-cover"
    />
    <!-- Sin foto todavía: plato de peltre con el nombre -->
    <div data-d-sin-foto hidden={Boolean(foto)} class="plato grid aspect-square place-items-center rounded-full border-[12px] border-peltre bg-blanco p-8 text-center">
      <div>
        <p data-d-plato-nombre class="font-titular text-xl leading-tight uppercase sm:text-2xl">{d?.nombre}</p>
        <p class="mt-3 font-mono text-[10px] tracking-widest text-peltre uppercase">[Foto pendiente]</p>
      </div>
    </div>
    <span data-d-etiqueta data-tipo={d?.etiqueta} hidden={!d?.etiqueta} class="etiqueta">{d?.etiqueta}</span>
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-3 border-b-2 border-dashed border-rojo pb-2">
    <p data-d-nombre class="font-titular text-base uppercase">{d?.nombre}</p>
    <p data-d-precio class="shrink-0 font-bold">{d?.precio}</p>
  </div>
  <p data-d-desc hidden={!d?.desc} class="mt-2 text-sm leading-snug">{d?.desc}</p>
</li>

<style>
  .plato {
    /* aro interior del plato de peltre */
    box-shadow: inset 0 0 0 6px var(--color-blanco), inset 0 0 0 8px color-mix(in srgb, var(--color-peltre) 35%, transparent);
  }
  /* Pegatina de Top / Promo / Nuevo */
  .etiqueta {
    position: absolute;
    top: -0.5rem;
    left: -0.35rem;
    z-index: 1;
    rotate: -7deg;
    padding: 0.3rem 0.85rem;
    border: 2.5px solid var(--color-rojo);
    border-radius: 999px;
    background: var(--color-blanco);
    color: var(--color-rojo);
    font-family: var(--font-titular);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    box-shadow: 3px 3px 0 var(--color-rojo-oscuro);
  }
  .etiqueta[data-tipo='Promo'] {
    background: var(--color-rojo);
    color: var(--color-blanco);
    border-color: var(--color-blanco);
  }
  .etiqueta[data-tipo='Nuevo'] {
    background: var(--color-peltre);
    color: var(--color-blanco);
    border-color: var(--color-blanco);
    box-shadow: 3px 3px 0 rgb(0 0 0 / 0.25);
  }
</style>
