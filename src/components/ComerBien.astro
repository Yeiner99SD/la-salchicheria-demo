---
import { Picture } from 'astro:assets';
import carta from '../assets/fotos/carta.jpg';
import { DESTACADOS_INICIALES } from '../data/destacados';
import { bibliotecaFotos } from '../data/fotos-destacados';
import { ruta } from '../lib/ruta';
import TituloCapitulo from './TituloCapitulo.astro';
import TarjetaDestacado from './TarjetaDestacado.astro';
import Icono from './Icono.astro';

// «Como Dios manda» enseña SOLO los destacados que elige el bar (tops, promos, novedades).
// Aquí se pintan los de partida; si en /admin se guardó otra lista, el navegador la sustituye
// antes de montar la galería (src/scripts/destacados.ts).
const fotos = await bibliotecaFotos();
const destacados = DESTACADOS_INICIALES.filter((d) => d.visible);

const textosZoom = [
  'La carta, en una hoja. Sin rodeos.',
  'Hasta Salchi tiene hambre.',
  'Los clásicos. Para compartir (o no).',
];
---

<section id="comer" aria-labelledby="comer-titulo" class="bg-blanco text-rojo">
  <!-- 1 · Título del capítulo -->
  <TituloCapitulo
    numero={1}
    id="comer-titulo"
    titulo={['Comer', 'bien']}
    sub="Pintxos, clásicos para compartir y algo de huerta. Para que luego no digan."
  />

  <!-- 2 · Foto protagonista fijada con zoom.
       Ahora es la carta (la única foto de producto en alta). Cuando lleguen las de perritos, valorar cambiarla. -->
  <div data-zoom class="relative flex min-h-svh flex-col items-center justify-center overflow-hidden py-6">
    <div
      data-zoom-img
      class="relative"
      style="aspect-ratio: 3273 / 4096; height: min(82vh, calc(88vw * 1.2514)); height: min(82svh, calc(88vw * 1.2514));"
    >
      <Picture
        src={carta}
        formats={['avif', 'webp']}
        widths={[480, 800, 1200, 1800]}
        sizes="(min-width: 768px) 130svh, 176vw"
        alt="La carta de La Salchichería en hojas con anilla: pintxos, los clásicos para compartir, huerta y vinos blancos, impresa en rojo y con Salchi sujetando un bocadillo."
        class="h-full w-full"
        pictureAttributes={{ class: 'block h-full w-full' }}
      />
    </div>

    <ol class="zoom-textos con-rail mt-6 w-full px-4 sm:px-8">
      {textosZoom.map((t, i) => (
        <li data-zoom-texto class="w-fit bg-rojo px-3 py-2 font-titular text-base text-blanco uppercase shadow-[4px_4px_0_var(--color-peltre)] sm:text-xl" style={`rotate: ${i % 2 ? 1.5 : -1.5}deg`}>
          {t}
        </li>
      ))}
    </ol>
  </div>

  <!-- 3 · Galería horizontal: platos de peltre -->
  <div data-galeria-wrap class="relative flex min-h-svh flex-col justify-center overflow-hidden py-14">
    <div class="con-rail px-4 sm:px-8">
      <p class="font-mano text-lg -rotate-1 sm:text-xl">En plato de peltre</p>
      <h3 class="font-titular text-[clamp(1.9rem,8vw,4rem)] leading-none uppercase">Como Dios manda</h3>
    </div>

    <div data-galeria class="galeria mt-8 pb-4" tabindex="0" aria-label="Destacados de la casa (desliza en horizontal)">
      <ul data-track class="flex w-max items-start gap-5 px-4 sm:gap-8 sm:px-8">
        {destacados.map((d) => <TarjetaDestacado destacado={d} foto={fotos[d.foto]} />)}

        <li data-plato data-destacados-cierre class="w-[70vw] max-w-[300px] shrink-0">
          <div class="grid aspect-square place-items-center rounded-full bg-rojo p-8 text-center text-blanco">
            <div>
              <p class="font-mano text-2xl">Y esto es</p>
              <p class="font-titular text-3xl leading-none uppercase">solo el principio</p>
              <p class="mt-3 font-mono text-xs tracking-widest uppercase">Fish &amp; chips, huerta, jeta…</p>
            </div>
          </div>
        </li>
      </ul>
    </div>

    <!-- Para la lista guardada desde /admin: plantilla de tarjeta y URL de las fotos de la biblioteca -->
    <template data-plantilla-destacado><TarjetaDestacado /></template>
    <script type="application/json" data-fotos-destacados set:html={JSON.stringify(fotos)} />
  </div>

  <!-- 4 · Al terminar el scroll de la carta: a la carta completa -->
  <div data-carta-cta class="con-rail px-4 pt-4 pb-24 text-center sm:px-8">
    <p class="font-mano text-xl -rotate-2 sm:text-2xl">¿Te has quedado con hambre?</p>
    <a href={ruta('carta/')} class="btn mt-5 bg-rojo whitespace-nowrap text-blanco shadow-[5px_5px_0_var(--color-peltre)] sm:px-8 sm:text-lg">
      Ver la carta completa <Icono nombre="flecha" />
    </a>
    <p class="mt-4 text-xs">Pintxos, clásicos, huerta, perritos y vinos. Con precios.</p>
  </div>
</section>

<style>
  .zoom-textos {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  /* Con movimiento: los textos se apilan en la misma celda y GSAP los va cambiando */
  :global(html.motion) .zoom-textos {
    position: absolute;
    left: 0;
    bottom: 1.5rem;
    display: grid;
  }
  :global(html.motion) .zoom-textos > li {
    grid-area: 1 / 1;
  }
</style>
