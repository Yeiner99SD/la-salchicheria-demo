---
/**
 * 4 · Catadores: solo reseñas reales de Google (texto, autor, procedencia y fecha si la hay).
 * Las reseñas se pegan en RESENAS (src/data/negocio.ts). Sin fotos intercaladas.
 */
import TituloCapitulo from './TituloCapitulo.astro';
import Icono from './Icono.astro';
import { RESENAS, enlaceResena } from '../data/negocio';

const giros = [-1.2, 1, 0.8, -1];
---

<section id="catadores" aria-labelledby="catadores-titulo" class="overflow-hidden bg-rojo text-blanco">
  <TituloCapitulo
    numero={4}
    id="catadores-titulo"
    titulo={['Cata', 'dores']}
    sub="Lo que dicen los que ya han pasado por la barra. Opiniones de verdad, que inventarlas no tiene gracia."
  />

  <ul data-posavasos class="con-rail mx-auto grid max-w-5xl gap-6 px-4 pb-14 sm:px-8 md:grid-cols-2 md:gap-8">
    {RESENAS.map((r, i) => (
      <li data-posavaso style={`rotate: ${giros[i % giros.length]}deg`}>
        <figure class="resena flex h-full flex-col rounded-[1.5rem] bg-blanco p-6 text-rojo sm:p-8">
          <blockquote class="flex-1 text-base leading-relaxed sm:text-lg">{r.texto}</blockquote>
          <figcaption class="mt-6 flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t-2 border-dashed border-rojo pt-4">
            <span class="font-titular text-sm uppercase sm:text-base">{r.autor}</span>
            <span class="inline-flex items-center gap-1.5 text-xs">
              <Icono nombre="google" class="inline-block size-[1.15em]" />
              Google{r.fecha && <Fragment> · {r.fecha}</Fragment>}
            </span>
          </figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <div class="con-rail mx-auto max-w-5xl px-4 pb-24 text-center sm:px-8">
    <p class="font-mano text-2xl -rotate-1">¿Ya has venido?</p>
    <a href={enlaceResena} class="btn mt-4 bg-blanco px-4 text-[0.72rem] tracking-normal whitespace-nowrap text-rojo sm:px-6 sm:text-sm sm:tracking-wide" rel="noopener" target="_blank">
      <Icono nombre="google" class="inline-block size-[1.1em]" />
      Déjanos tu opinión en Google<span class="sr-only"> (se abre en otra pestaña)</span>
    </a>
  </div>
</section>

<style>
  .resena {
    box-shadow: 0 10px 0 -2px var(--color-rojo-oscuro);
  }
</style>
