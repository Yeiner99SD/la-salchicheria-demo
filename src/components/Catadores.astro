---
import TituloCapitulo from './TituloCapitulo.astro';
import { Image } from 'astro:assets';
import FotoProvisional from './FotoProvisional.astro';
import perritosPlato from '../assets/fotos/perritos-plato.jpg';
import { RESENAS_PENDIENTES, MAPA_RESENAS } from '../data/negocio';

// Orden de la mesa: reseña, foto, reseña, reseña, foto, reseña
const giros = [-7, 5, -3, 8, -5, 4];
type Posavaso = { tipo: 'resena'; texto: string } | { tipo: 'foto'; foto: string; real?: { src: ImageMetadata; alt: string } };
const mesa: Posavaso[] = [
  { tipo: 'resena', texto: RESENAS_PENDIENTES[0] },
  { tipo: 'foto', foto: 'clientes brindando con cañas en la barra' },
  { tipo: 'resena', texto: RESENAS_PENDIENTES[1] },
  { tipo: 'resena', texto: RESENAS_PENDIENTES[2] },
  {
    tipo: 'foto',
    foto: 'perritos',
    real: {
      src: perritosPlato,
      alt: 'Dos perritos con queso, salsa y patatas paja en su caja de cartón, sobre un plato de peltre que alguien lleva a la mesa.',
    },
  },
  { tipo: 'resena', texto: RESENAS_PENDIENTES[3] },
];
import Icono from './Icono.astro';
---

<section id="catadores" aria-labelledby="catadores-titulo" class="overflow-hidden bg-rojo text-blanco">
  <TituloCapitulo
    numero={4}
    id="catadores-titulo"
    titulo={['Cata', 'dores']}
    sub="Lo que dicen los que ya han pasado por la barra. Opiniones de verdad, que inventarlas no tiene gracia."
  />

  <ul data-posavasos class="con-rail mx-auto grid max-w-6xl grid-cols-2 gap-x-4 gap-y-8 px-4 pb-12 sm:px-8 md:grid-cols-3 md:gap-10">
    {mesa.map((p, i) => (
      <li data-posavaso style={`rotate: ${giros[i]}deg`} class:list={[i % 2 === 1 && 'translate-y-6']}>
        {p.tipo === 'resena' ? (
          <figure class="posavaso grid aspect-square place-items-center rounded-full bg-blanco p-[14%] text-center text-rojo">
            <div>
              <p class="flex justify-center gap-0.5" role="img" aria-label="Cinco estrellas">{[1, 2, 3, 4, 5].map(() => <Icono nombre="estrella" class="size-3.5" />)}</p>
              <blockquote class="mt-2 font-mono text-[11px] leading-snug sm:text-sm">{p.texto}</blockquote>
              <figcaption class="mt-2 font-titular text-[11px] uppercase sm:text-xs">— [Nombre] · Google</figcaption>
            </div>
          </figure>
        ) : (
          <div class="posavaso-cuadrado overflow-hidden rounded-[1.25rem] border-[6px] border-blanco">
            {p.real ? (
              <Image src={p.real.src} alt={p.real.alt} widths={[200, 400]} sizes="(min-width: 768px) 280px, 45vw" class="aspect-square w-full object-cover" />
            ) : (
              <FotoProvisional foto={p.foto} icono="brindis" tono="cerveza" ratio="1 / 1" />
            )}
          </div>
        )}
      </li>
    ))}
  </ul>

  <div class="con-rail mx-auto max-w-6xl px-4 pb-24 text-center sm:px-8">
    <p class="font-mano text-2xl -rotate-1">¿Ya has venido?</p>
    <a href={MAPA_RESENAS} class="btn mt-4 bg-blanco text-rojo" rel="noopener" target="_blank">
      Cuéntalo en Google <Icono nombre="flecha" /><span class="sr-only"> (se abre en otra pestaña)</span>
    </a>
  </div>
</section>

<style>
  .posavaso {
    /* doble aro impreso, como los posavasos de cartón */
    box-shadow:
      inset 0 0 0 6px var(--color-blanco),
      inset 0 0 0 9px var(--color-rojo),
      inset 0 0 0 13px var(--color-blanco),
      inset 0 0 0 14px var(--color-rojo),
      0 10px 0 -2px var(--color-rojo-oscuro);
  }
  .posavaso-cuadrado {
    box-shadow: 0 10px 0 -2px var(--color-rojo-oscuro);
  }
</style>
