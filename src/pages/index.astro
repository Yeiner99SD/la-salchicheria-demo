---
import Base from '../layouts/Base.astro';
import SalchiRail from '../components/SalchiRail.astro';
import Portada from '../components/Portada.astro';
import ComerBien from '../components/ComerBien.astro';
import BeberMejor from '../components/BeberMejor.astro';
import PasearLoJusto from '../components/PasearLoJusto.astro';
import Catadores from '../components/Catadores.astro';
import Final from '../components/Final.astro';
import Pie from '../components/Pie.astro';
import BotonArriba from '../components/BotonArriba.astro';
---

<Base>
  <SalchiRail />
  <BotonArriba destino="portada" />
  <Portada />
  <main id="contenido">
    <ComerBien />
    <BeberMejor />
    <PasearLoJusto />
    <Catadores />
    <Final />
  </main>
  <Pie />
</Base>

<script>
  // El orden importa: primero se colocan los destacados guardados y luego se montan las animaciones
  import '../scripts/destacados';
  import '../scripts/movimiento';
</script>
