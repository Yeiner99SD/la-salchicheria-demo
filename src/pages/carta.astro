---
/**
 * Carta completa: solo productos y precios, por secciones (sin fotos).
 * Se pinta con CARTA_INICIAL (src/data/carta.ts). Si desde /admin se guardó otra carta en este
 * navegador, src/scripts/carta.ts la sustituye usando las plantillas de abajo.
 */
import Base from '../layouts/Base.astro';
import Salchi from '../components/Salchi.astro';
import AbiertoAhora from '../components/AbiertoAhora.astro';
import Icono from '../components/Icono.astro';
import Pie from '../components/Pie.astro';
import BotonArriba from '../components/BotonArriba.astro';
import { NEGOCIO } from '../data/negocio';
import { CARTA_INICIAL } from '../data/carta';
import { ruta } from '../lib/ruta';

const claseEnlace =
  'inline-flex min-h-10 items-center rounded-full border-2 border-rojo px-4 font-titular text-xs uppercase hover:bg-rojo hover:text-blanco';
---

<Base
  title="La carta | La Salchichería · Oeste 7 (Salamanca)"
  description="La carta completa de La Salchichería: perritos, pintxos, clásicos para compartir, huerta, cañas y vinos, con precios. Plaza del Oeste, 7 · Salamanca."
>
  <BotonArriba destino="inicio" />

  <header id="inicio" class="bg-rojo text-blanco">
    <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-4 pt-4 text-[11px] uppercase tracking-[0.18em] sm:px-8 sm:text-xs">
      <a href={ruta()} class="inline-flex min-h-11 items-center gap-2 font-bold underline-offset-4 hover:underline">
        <Icono nombre="flecha" class="inline-block size-[1.1em] rotate-180" /> Volver al bar
      </a>
      <span>{NEGOCIO.direccion.calle}</span>
    </div>

    <div class="mx-auto flex max-w-3xl items-end gap-5 px-4 pt-8 pb-10 sm:px-8 sm:pt-12">
      <div class="min-w-0 flex-1">
        <p class="font-mano text-xl -rotate-2 sm:text-2xl">Hambre no vais a pasar</p>
        <h1 class="mt-3 font-condensada text-[clamp(4rem,20vw,8rem)] leading-[0.9] uppercase">La carta</h1>
        <div class="mt-5"><AbiertoAhora /></div>
      </div>
      <Salchi class="mb-2 w-[22vw] max-w-[120px] min-w-[72px] shrink-0 text-blanco" />
    </div>
  </header>

  <!-- Índice: se queda arriba al bajar -->
  <nav aria-label="Secciones de la carta" class="sticky top-0 z-40 border-b-2 border-rojo bg-blanco">
    <ul data-carta-indice class="mx-auto flex max-w-3xl gap-2 overflow-x-auto px-4 py-3 sm:px-8 [scrollbar-width:none]">
      {CARTA_INICIAL.map((s) => (
        <li class="shrink-0"><a href={`#${s.id}`} class={claseEnlace}>{s.titulo}</a></li>
      ))}
    </ul>
  </nav>

  <main id="contenido" class="mx-auto max-w-3xl px-4 pb-20 sm:px-8">
    <div data-carta-secciones>
      {CARTA_INICIAL.map((s) => (
        <section id={s.id} aria-labelledby={`${s.id}-titulo`} class="scroll-mt-20 pt-14">
          <div class="flex flex-wrap items-baseline gap-x-4">
            <h2 id={`${s.id}-titulo`} class="font-mano text-4xl uppercase sm:text-5xl">{s.titulo}</h2>
            {s.nota && <p class="font-mono text-xs tracking-[0.2em] uppercase">({s.nota})</p>}
          </div>
          <ul class="mt-6 space-y-5">
            {s.platos.map((p) => (
              <li>
                <div class="flex items-baseline gap-3">
                  <h3 class="font-titular text-base leading-tight uppercase sm:text-lg">{p.nombre}</h3>
                  {p.precio && <span class="relative top-[-0.25em] min-w-4 flex-1 border-b-2 border-dotted border-rojo" aria-hidden="true"></span>}
                  {p.precio && <p class="shrink-0 font-bold">{p.precio}</p>}
                </div>
                {p.desc && <p class="mt-1 max-w-[52ch] text-sm leading-snug">{p.desc}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Cierre: sin reservas -->
    <section aria-labelledby="cierre-titulo" class="mt-20 rounded-[2rem] bg-rojo px-6 py-10 text-center text-blanco sm:px-10">
      <h2 id="cierre-titulo" class="font-condensada text-[clamp(2.5rem,11vw,4.5rem)] leading-[0.9] uppercase">¿Hacéis reservas?</h2>
      <p class="mt-3 font-titular text-lg uppercase sm:text-xl">No, solo tienes que venir.</p>
      <p class="mt-2 text-sm">Según llegas te hacemos hueco.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href={NEGOCIO.comoLlegar} class="btn bg-blanco text-rojo" rel="noopener" target="_blank">
          Cómo llegar <Icono nombre="flecha" /><span class="sr-only"> (Google Maps, se abre en otra pestaña)</span>
        </a>
        <a href={ruta()} class="btn border-2 border-blanco text-blanco">Volver al bar</a>
      </div>
    </section>

    <p class="mt-8 text-center text-xs">Si tienes alguna alergia, pregúntanos: te contamos qué lleva cada plato.</p>
  </main>

  <!-- Plantillas para la carta guardada desde /admin (mismo marcado que arriba) -->
  <template data-plantilla-enlace><li class="shrink-0"><a class={claseEnlace}></a></li></template>
  <template data-plantilla-seccion>
    <section class="scroll-mt-20 pt-14">
      <div class="flex flex-wrap items-baseline gap-x-4">
        <h2 class="font-mano text-4xl uppercase sm:text-5xl"></h2>
        <p data-nota class="font-mono text-xs tracking-[0.2em] uppercase"></p>
      </div>
      <ul class="mt-6 space-y-5"></ul>
    </section>
  </template>
  <template data-plantilla-plato>
    <li>
      <div class="flex items-baseline gap-3">
        <h3 class="font-titular text-base leading-tight uppercase sm:text-lg"></h3>
        <span data-guia class="relative top-[-0.25em] min-w-4 flex-1 border-b-2 border-dotted border-rojo" aria-hidden="true"></span>
        <p data-precio class="shrink-0 font-bold"></p>
      </div>
      <p data-desc class="mt-1 max-w-[52ch] text-sm leading-snug"></p>
    </li>
  </template>

  <Pie />
</Base>

<script>
  import '../scripts/carta';
</script>
